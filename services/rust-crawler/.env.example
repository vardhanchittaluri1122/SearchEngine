DB_HOST=localhost
DB_PORT=5434
DB_NAME=searchengine_db
DB_USER=searchadmin
DB_PASSWORD=put-your-local-password-here
# Shared local service. One Rust process opens the sector database named in each request.
# Create the databases from infrastructure/provision-sector-databases.ps1 first.
# DB_NAME is only the startup/default database; normal requests use database_name from Python.
# Leave CRAWLER_LISTEN_ADDR unset on Render to use its PORT.
CRAWLER_LISTEN_ADDR=127.0.0.1:8081
DB_MAX_ACTIVE_REQUESTS=20
CC_RECORD_LIMIT=100
CC_PAGE_LIMIT=30
CC_MAX_PARALLEL_DOMAINS=2
# Optional. If omitted, the crawler selects the first collection in Common Crawl's current collection list.
# CC_INDEX_URL=https://index.commoncrawl.org/CC-MAIN-2026-43-index

CC_DOMAIN_SIMILARITY_THRESHOLD=0.35
