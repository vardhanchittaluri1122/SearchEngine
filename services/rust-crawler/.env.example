DB_HOST=localhost
DB_PORT=5434
DB_NAME=searchengine_db
DB_USER=searchadmin
DB_PASSWORD=put-your-local-password-here
# Local default. Leave CRAWLER_LISTEN_ADDR unset on Render to use its PORT.
CRAWLER_LISTEN_ADDR=127.0.0.1:8081
# The second local process uses CRAWLER_LISTEN_ADDR=127.0.0.1:8082 and
# DB_NAME=searchengine_health. On Render, deploy a second Rust service and set
# DB_NAME=searchengine_health in that service's environment.
CC_RECORD_LIMIT=100
CC_PAGE_LIMIT=30
CC_MAX_PARALLEL_DOMAINS=2
# Optional. If omitted, the crawler selects the first collection in Common Crawl's current collection list.
# CC_INDEX_URL=https://index.commoncrawl.org/CC-MAIN-2026-43-index

CC_DOMAIN_SIMILARITY_THRESHOLD=0.35
